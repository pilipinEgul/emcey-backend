# =============================================================================
# PRODUCTION .env  —  api.emcey-brows-aesthetics.com
# =============================================================================
# Copy this to `.env` ON THE HOSTINGER SERVER (production directory) ONLY.
# It is NEVER committed and NEVER uploaded by the deploy (rsync excludes .env).
# Generate APP_KEY once on the server:  php artisan key:generate
# =============================================================================

APP_NAME="Emcey Brows Aesthetics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.emcey-brows-aesthetics.com
APP_TIMEZONE=Asia/Manila

APP_FRONTEND_URL=https://emcey-brows-aesthetics.com
# Comma-separated. Include www + apex; add staging only if it must hit prod API.
CORS_ALLOWED_ORIGINS=https://emcey-brows-aesthetics.com,https://www.emcey-brows-aesthetics.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Admin seeder — set real credentials before the first `migrate --seed`.
ADMIN_NAME="Emcey Studio"
ADMIN_EMAIL=admin@emcey-brows-aesthetics.com
ADMIN_PASSWORD=change-me-to-something-strong

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- MySQL (create the DB + user in hPanel → Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_emcey_prod
DB_USERNAME=uXXXXXXXX_emcey
DB_PASSWORD=

# On shared hosting DB-backed drivers are the safe default (no Redis daemon).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.emcey-brows-aesthetics.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail (Hostinger email or SMTP relay) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@emcey-brows-aesthetics.com
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@emcey-brows-aesthetics.com"
MAIL_FROM_NAME="${APP_NAME}"
