# =============================================================================
# STAGING .env  —  staging-api.emcey-brows-aesthetics.com
# =============================================================================
# Copy this to `.env` ON THE HOSTINGER SERVER (staging directory) ONLY.
# Use a SEPARATE database from production. Generate APP_KEY on the server:
#   php artisan key:generate
# =============================================================================

APP_NAME="Emcey Brows Aesthetics (Staging)"
APP_ENV=staging
APP_KEY=
# Debug on in staging is fine — it is not public-facing production.
APP_DEBUG=true
APP_URL=https://staging-api.emcey-brows-aesthetics.com
APP_TIMEZONE=Asia/Manila

APP_FRONTEND_URL=https://staging.emcey-brows-aesthetics.com
CORS_ALLOWED_ORIGINS=https://staging.emcey-brows-aesthetics.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ADMIN_NAME="Emcey Studio (Staging)"
ADMIN_EMAIL=admin@staging.emcey-brows-aesthetics.com
ADMIN_PASSWORD=change-me

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- MySQL — a DIFFERENT database from production ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_emcey_staging
DB_USERNAME=uXXXXXXXX_emcey_stg
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.emcey-brows-aesthetics.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@staging.emcey-brows-aesthetics.com"
MAIL_FROM_NAME="${APP_NAME}"
